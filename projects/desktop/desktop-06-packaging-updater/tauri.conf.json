{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-06-packaging-updater",
  "version": "1.0.0",
  "identifier": "com.rustsandbox.desktop06",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rust Desktop 06: Tauri 2.0 Packaging & Auto-Updater",
        "width": 1060,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["Korean", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0OUVGNDc0NkZBNkU2RDcKUldUWDVxWnZkUFNlcERHV2cyYno4bjZBclFuQk13Z1FLMWdlVm9zb3JjYkx6Y3VuRCtLSitjWWUK",
      "endpoints": [
        "https://github.com/space-cap/rust-sandbox/releases/latest/download/latest.json"
      ]
    }
  }
}

