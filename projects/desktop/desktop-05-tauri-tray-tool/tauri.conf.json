{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-05-tauri-tray-tool",
  "version": "0.1.0",
  "identifier": "com.rustsandbox.desktop05",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rust Desktop 05: Tauri 2.0 Tray & Background Tool",
        "width": 1020,
        "height": 720,
        "minWidth": 800,
        "minHeight": 580,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

